# Copy to .env. Never commit .env.
NODE_ENV=production
LOG_LEVEL=info
APP_TIMEZONE=Africa/Khartoum
PORT=3000

POSTGRES_PASSWORD=
# DATABASE_URL is set by docker-compose; set it yourself only when running outside Docker.
DATABASE_URL=

# WhatsApp provider: "openwa" (Docker gateway, below) or "baileys" (lite mode: one process, no Docker,
# login stored in Postgres; see docs/LITE_DEPLOYMENT.md). In lite mode only ADMIN_HTTP_TOKEN is needed.
# ADMIN_HTTP_TOKEN protects /admin/link (QR / pairing code page). >= 16 random chars.
ADMIN_HTTP_TOKEN=
# WhatsApp gateway (OpenWA). OPENWA_API_KEY is also OpenWA's master key (>=32 chars).
WHATSAPP_PROVIDER=openwa
OPENWA_BASE_URL=http://openwa:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=

# Telegram (GramJS)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=BahriMed
TELEGRAM_SESSION_STRING=

# Google Drive
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Bootstrap admins, comma separated WhatsApp ids (e.g. 249xxxxxxxxx@c.us)
ADMIN_IDS=

DB_POOL_MAX=10
TEMP_FILE_DIR=./tmp
ENABLE_SCHEDULER=true

# Optional initial values for runtime settings. Admins can override them later from the
# app_settings table (see src/settings/registry.ts); no redeploy needed.
# COHORT_LABEL= GROUP_MODE=enabled GROUP_REPLY_MODE=reply_in_group SESSION_TTL_MINUTES=30
# PAGE_SIZE=8 MAX_SEARCH_RESULTS=10 MAX_ATTACHMENT_SIZE_MB=64
# TELEGRAM_SYNC_INTERVAL_MINUTES=10 DRIVE_SYNC_INTERVAL_MINUTES=30
